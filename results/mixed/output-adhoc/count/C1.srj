{"ReactionTitle":{"value":"UDP-D-galactose + Sucrose <=> UDP + 6F-alpha-D-Galactosylsucrose","type":"literal"},"compound":{"value":"http://bio2rdf.org/cpd:C00052","type":"uri"},"ChemicalEquation":{"value":"C00052 + C00089 <=> C00015 + C03848","type":"literal"},"drug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB03501","type":"uri"},"drugDesc":{"value":"A nucleoside diphosphate sugar which can be epimerized into UDPglucose for entry into the mainstream of carbohydrate metabolism. Serves as a source of galactose in the synthesis of lipopolysaccharides, cerebrosides, and lactose. [PubChem]","type":"literal"}},
{"ReactionTitle":{"value":"UDP-D-galactose + Sucrose <=> UDP + 6F-alpha-D-Galactosylsucrose","type":"literal"},"compound":{"value":"http://bio2rdf.org/cpd:C00089","type":"uri"},"ChemicalEquation":{"value":"C00052 + C00089 <=> C00015 + C03848","type":"literal"},"drug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB02772","type":"uri"},"drugDesc":{"value":"A nonreducing disaccharide composed of glucose and fructose linked via their anomeric carbons. It is obtained commercially from sugarcane, sugar beet (beta vulgaris), and other plants and used extensively as a food and a sweetener. [PubChem]","type":"literal"}},
