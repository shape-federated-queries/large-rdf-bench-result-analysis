{"ReactionTitle":{"value":"L-Tyrosine + Oxygen <=> 3,4-Dihydroxy-L-phenylalanine + H2O","type":"literal"},"compound":{"value":"http://bio2rdf.org/cpd:C00355","type":"uri"},"ChemicalEquation":{"value":"C00082 + C00007 <=> C00355 + C00001","type":"literal"},"drug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB01235","type":"uri"},"drugDesc":{"value":"The naturally occurring form of dihydroxyphenylalanine and the immediate precursor of dopamine. Unlike dopamine itself, it can be taken orally and crosses the blood-brain barrier. It is rapidly taken up by dopaminergic neurons and converted to dopamine. It is used for the treatment of parkinsonian disorders and is usually given with agents that inhibit its conversion to dopamine outside of the central nervous system. [PubChem]","type":"literal"}},
{"ReactionTitle":{"value":"L-Tyrosine + 2-Oxoglutarate <=> 3-(4-Hydroxyphenyl)pyruvate + L-Glutamate","type":"literal"},"compound":{"value":"http://bio2rdf.org/cpd:C00049","type":"uri"},"ChemicalEquation":{"value":"C00082 + C00026 <=> C01179 + C00025","type":"literal"},"drug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00128","type":"uri"},"drugDesc":{"value":"One of the non-essential amino acids commonly occurring in the L-form. It is found in animals and plants, especially in sugar cane and sugar beets. It may be a neurotransmitter. [PubChem]","type":"literal"}},
{"ReactionTitle":{"value":"ATP + L-Tyrosine + L-Arginine <=> AMP + Diphosphate + L-Tyrosyl-L-arginine","type":"literal"},"compound":{"value":"http://bio2rdf.org/cpd:C00002","type":"uri"},"ChemicalEquation":{"value":"C00002 + C00082 + C00062 <=> C00020 + C00013 + C02993","type":"literal"},"drug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00171","type":"uri"},"drugDesc":{"value":"An adenine nucleotide containing three phosphate groups esterified to the sugar moiety. In addition to its crucial roles in metabolism adenosine triphosphate is a neurotransmitter. [PubChem]","type":"literal"}},
{"ReactionTitle":{"value":"ATP + L-Tyrosine + L-Arginine <=> AMP + Diphosphate + L-Tyrosyl-L-arginine","type":"literal"},"compound":{"value":"http://bio2rdf.org/cpd:C00062","type":"uri"},"ChemicalEquation":{"value":"C00002 + C00082 + C00062 <=> C00020 + C00013 + C02993","type":"literal"},"drug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00125","type":"uri"},"drugDesc":{"value":"An essential amino acid that is physiologically active in the L-form. [PubChem]","type":"literal"}},
{"ReactionTitle":{"value":"L-Tyrosine <=> Tyramine + CO2","type":"literal"},"compound":{"value":"http://bio2rdf.org/cpd:C00355","type":"uri"},"ChemicalEquation":{"value":"C00082 <=> C00483 + C00011","type":"literal"},"drug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB01235","type":"uri"},"drugDesc":{"value":"The naturally occurring form of dihydroxyphenylalanine and the immediate precursor of dopamine. Unlike dopamine itself, it can be taken orally and crosses the blood-brain barrier. It is rapidly taken up by dopaminergic neurons and converted to dopamine. It is used for the treatment of parkinsonian disorders and is usually given with agents that inhibit its conversion to dopamine outside of the central nervous system. [PubChem]","type":"literal"}},
{"ReactionTitle":{"value":"L-Tyrosine <=> Tyramine + CO2","type":"literal"},"compound":{"value":"http://bio2rdf.org/cpd:C00643","type":"uri"},"ChemicalEquation":{"value":"C00082 <=> C00483 + C00011","type":"literal"},"drug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB02959","type":"uri"},"drugDesc":{"value":"The immediate precursor in the biosynthesis of SEROTONIN from tryptophan. It is used as an antiepileptic and antidepressant. [PubChem]","type":"literal"}},
{"ReactionTitle":{"value":"L-Tyrosine <=> 4-Coumarate + NH3","type":"literal"},"compound":{"value":"http://bio2rdf.org/cpd:C00079","type":"uri"},"ChemicalEquation":{"value":"C00082 <=> C00811 + C00014","type":"literal"},"drug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00120","type":"uri"},"drugDesc":{"value":"An essential aromatic amino acid that is a precursor of melanin; dopamine; noradrenalin (norepinephrine), and thyroxine. [PubChem]","type":"literal"}},
