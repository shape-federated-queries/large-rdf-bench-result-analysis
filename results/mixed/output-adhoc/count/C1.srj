{"ReactionTitle":{"value":"ATP + L-Histidine + 4-Aminobutanoate <=> AMP + Diphosphate + Homocarnosine","type":"literal"},"compound":{"value":"http://bio2rdf.org/cpd:C00099","type":"uri"},"ChemicalEquation":{"value":"C00002 + C00135 + C00334 <=> C00020 + C00013 + C00884","type":"literal"},"drug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB03107","type":"uri"},"drugDesc":{"value":"An amino acid formed in vivo by the degradation of dihydrouracil and carnosine. Since neuronal uptake and neuronal receptor sensitivity to beta-alanine have been demonstrated, the compound may be a false transmitter replacing GAMMA-AMINOBUTYRIC ACID. A rare genetic disorder, hyper-beta-alaninemia, has been reported. [PubChem]","type":"literal"}},
{"ReactionTitle":{"value":"ATP + L-Histidine + 4-Aminobutanoate <=> AMP + Diphosphate + Homocarnosine","type":"literal"},"compound":{"value":"http://bio2rdf.org/cpd:C00135","type":"uri"},"ChemicalEquation":{"value":"C00002 + C00135 + C00334 <=> C00020 + C00013 + C00884","type":"literal"},"drug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00117","type":"uri"},"drugDesc":{"value":"An essential amino acid that is required for the production of histamine. [PubChem]","type":"literal"}},
