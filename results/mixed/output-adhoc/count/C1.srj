{"ReactionTitle":{"value":"ATP + Creatine <=> ADP + Phosphocreatine","type":"literal"},"compound":{"value":"http://bio2rdf.org/cpd:C00300","type":"uri"},"ChemicalEquation":{"value":"C00002 + C00300 <=> C00008 + C02305","type":"literal"},"drug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00148","type":"uri"},"drugDesc":{"value":"An amino acid that occurs in vertebrate tissues and in urine.  In muscle tissue, creatine generally occurs as phosphocreatine.  Creatine is excreted as creatinine in the urine. [PubChem]","type":"literal"}},
{"ReactionTitle":{"value":"S-Adenosyl-L-methionine + Guanidinoacetate <=> S-Adenosyl-L-homocysteine + Creatine","type":"literal"},"compound":{"value":"http://bio2rdf.org/cpd:C00019","type":"uri"},"ChemicalEquation":{"value":"C00019 + C00581 <=> C00021 + C00300","type":"literal"},"drug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00118","type":"uri"},"drugDesc":{"value":"Physiologic methyl radical donor involved in enzymatic transmethylation reactions and present in all living organisms. It possesses anti-inflammatory activity and has been used in treatment of chronic liver disease. (From Merck, 11th ed)","type":"literal"}},
