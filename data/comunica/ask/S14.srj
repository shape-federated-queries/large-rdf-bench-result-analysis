{"drug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00799","type":"uri"},"mass":{"value":"351.1293","type":"literal"},"transform":{"value":"Undergoes esterase hydrolysis in skin to form its active metabolite, tazarotenic acid. Tazarotenic acid is further metabolized in skin and, after systemic absorption, hepatically metabolized to sulfoxides, sulfones, and other polar products for elimination.","type":"literal"}},
{"drug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00302","type":"uri"},"mass":{"value":"157.1103","type":"literal"},"transform":{"value":"Only a small fraction of the drug is metabolized (less than 5%).","type":"literal"}},
