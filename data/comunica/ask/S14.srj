{"drug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00566","type":"uri"},"mass":{"value":"181.9708","type":"literal"},"transform":{"value":"Chemical analysis of succimer and its metabolites (primarily mixed disulfides of L-cysteine) in the urine showed that succimer was rapidly and extensively metabolized however the specific site of biotransformation is not known.","type":"literal"}},
{"drug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00007","type":"uri"},"mass":{"value":"1208.6455","type":"literal"}},
