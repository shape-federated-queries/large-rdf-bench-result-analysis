{"drug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00462","type":"uri"},"mass":{"value":"397.0889","type":"literal"},"transform":{"value":"Little is known about the fate and excretion of methscopolamine.","type":"literal"}},
