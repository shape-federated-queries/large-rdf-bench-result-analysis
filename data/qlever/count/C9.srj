{"InteractionName":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drug_interactions/DB00187_DB00247","type":"uri"},"drugbankDrug2":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00247","type":"uri"},"IntEffect":{"value":"Ischemia with risk of gangrene","type":"literal"},"drugbankDrug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00187","type":"uri"},"Drug":{"value":"http://dbpedia.org/resource/Esmolol","type":"uri"},"description":{"value":"Esmolol (trade name Brevibloc) is a cardioselective beta1 receptor blocker with rapid onset, a very short duration of action, and no significant intrinsic sympathomimetic or membrane stabilising activity at therapeutic dosages.\nEsmolol decreases the force and rate of heart contractions by blocking beta-adrenergic receptors of the sympathetic nervous system, which are found in the heart and other organs of the body. Esmolol prevents the action of two naturally occurring substances: epinephrine and norepinephrine.","type":"literal"},"structure":{"value":"1","type":"literal"},"casRegistryNumber":{"value":"http://bio2rdf.org/cas:103598-03-4","type":"uri"}},
{"InteractionName":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drug_interactions/DB00187_DB00281","type":"uri"},"drugbankDrug2":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00281","type":"uri"},"IntEffect":{"value":"The beta-blocker increases the effect and toxicity of lidocaine","type":"literal"},"drugbankDrug":{"value":"http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugs/DB00187","type":"uri"},"Drug":{"value":"http://dbpedia.org/resource/Esmolol","type":"uri"},"description":{"value":"Esmolol (trade name Brevibloc) is a cardioselective beta1 receptor blocker with rapid onset, a very short duration of action, and no significant intrinsic sympathomimetic or membrane stabilising activity at therapeutic dosages.\nEsmolol decreases the force and rate of heart contractions by blocking beta-adrenergic receptors of the sympathetic nervous system, which are found in the heart and other organs of the body. Esmolol prevents the action of two naturally occurring substances: epinephrine and norepinephrine.","type":"literal"},"structure":{"value":"1","type":"literal"},"casRegistryNumber":{"value":"http://bio2rdf.org/cas:103598-03-4","type":"uri"}}
